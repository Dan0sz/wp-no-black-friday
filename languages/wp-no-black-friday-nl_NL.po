#. Plugin Name of the plugin
#: wp-no-black-friday.php
msgid "No Black Friday for WordPress"
msgstr "No Black Friday for WordPress"

#. Description of the plugin
#: wp-no-black-friday.php
msgid "Shows a bar at the top of your site in November, to tell visitors you don't do Black Friday deals, because your price is always the best deal."
msgstr "Toont in november een balk bovenaan je site, om bezoekers te vertellen dat je niet aan Black Friday-deals doet, omdat je prijs altijd de beste deal is."

#. Author of the plugin
#: wp-no-black-friday.php
msgid "Daan from Daan.dev"
msgstr "Daan van Daan.dev"

#. Author URI of the plugin
#: wp-no-black-friday.php
msgid "https://daan.dev"
msgstr "https://daan.dev"

#: src/Bar.php:50
msgid "No Black Friday deals"
msgstr "Geen Black Friday-deals"

#: src/Bar.php:53
msgid "Black Friday"
msgstr "Black Friday"

#: src/Bar.php:56
msgid "Here's why"
msgstr "Dit is waarom"

#: src/Bar.php:60
msgid "Close"
msgstr "Sluiten"

#. translators: %s: the site's name
#: src/Bar.php:103
#, php-format
msgid "<strong>Not at %s.</strong> My best price isn't seasonal, you're already looking at it. No countdown timer needed."
msgstr "<strong>Niet bij %s.</strong> Mijn beste prijs geldt het hele jaar, je kijkt er al naar. Een afteltimer is niet nodig."
